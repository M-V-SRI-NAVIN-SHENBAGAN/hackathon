# Copy this file to `.env` (same folder as this file) and edit the values.
# The application reads this file automatically when it starts.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_db
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: instead of the five values above you may give one connection
# string. If DATABASE_URL is set it takes priority.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_db
